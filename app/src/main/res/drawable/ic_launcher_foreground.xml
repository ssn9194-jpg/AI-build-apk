<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Inner safe-area group centered at (54,54) within 66dp diameter -->
    <group
        android:pivotX="54"
        android:pivotY="54">

        <!-- Glowing Hexagon / Shield Backdrop -->
        <path
            android:pathData="M54,26 L76,38 L76,64 L54,78 L32,64 L32,38 Z"
            android:strokeWidth="2"
            android:strokeColor="#818CF8">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="32"
                    android:startY="26"
                    android:endX="76"
                    android:endY="78"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#336366F1" />
                    <item android:offset="1.0" android:color="#1AEC4899" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Code brackets < / > inside -->
        <!-- Left bracket < -->
        <path
            android:pathData="M46,45 L39,52 L46,59"
            android:strokeColor="#38BDF8"
            android:strokeWidth="2.8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <!-- Right bracket > -->
        <path
            android:pathData="M62,45 L69,52 L62,59"
            android:strokeColor="#C084FC"
            android:strokeWidth="2.8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <!-- Center AI Sparkle 4-point star -->
        <path
            android:pathData="M54,42 Q54,52 60,52 Q54,52 54,62 Q54,52 48,52 Q54,52 54,42 Z"
            android:fillColor="#FDF2F8" />

        <!-- Droid Antennae Accent -->
        <path
            android:pathData="M48,34 L43,29 M60,34 L65,29"
            android:strokeColor="#A5B4FC"
            android:strokeWidth="2"
            android:strokeLineCap="round" />
    </group>
</vector>
